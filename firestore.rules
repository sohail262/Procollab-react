rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Common Functions ──────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isValidUser() {
      return request.auth != null && request.auth.uid != null;
    }

    // ── Single cached project doc read ────────────────────────────────────────
    // Firestore caches get() calls within a single request evaluation.
    // All helpers below reuse this — only ONE actual read per rule evaluation.
    function getProject(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data;
    }

    function projectExists(projectId) {
      return exists(/databases/$(database)/documents/projects/$(projectId));
    }

    // ── Is user the project creator? ──────────────────────────────────────────
    function isProjectOwner(projectId) {
      return projectExists(projectId) &&
             getProject(projectId).createdBy == request.auth.uid;
    }

    // ── Is user in teamMembers map? ───────────────────────────────────────────
    // Uses `in` operator — faster and safer than map[uid] != null
    function isProjectTeamMember(projectId) {
      return projectExists(projectId) &&
             getProject(projectId).teamMembers != null &&
             request.auth.uid in getProject(projectId).teamMembers;
    }

    // ── Owner OR any team member ──────────────────────────────────────────────
    function canAccessProject(projectId) {
      return isProjectOwner(projectId) || isProjectTeamMember(projectId);
    }

    // ── Owner or Admin/Lead role in teamMembers map ───────────────────────────
    function isProjectTeamLead(projectId) {
      return projectExists(projectId) &&
             getProject(projectId).teamMembers != null &&
             request.auth.uid in getProject(projectId).teamMembers &&
             (
               getProject(projectId).teamMembers[request.auth.uid].role == 'Owner' ||
               getProject(projectId).teamMembers[request.auth.uid].role == 'Admin'
             );
    }

    // ── Task field helpers ────────────────────────────────────────────────────

    // Only status + updatedAt are changing (assignee drag-drop)
    function isOnlyStatusUpdate() {
      return request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly(['status', 'updatedAt']);
    }

    // Assignee updating status with review fields (MyTasksPanel)
    function isAssigneeStatusUpdateWithReview() {
      let allowedFields = ['status', 'updatedAt', 'statusNote', 'reviewStatus', 
                          'submittedAt', 'submittedBy', 'reviewNote', 'reviewedBy', 'reviewedAt'];
      return request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly(allowedFields);
    }

    // Task assigneeId matches current user
    function isTaskAssignee() {
      return resource.data.assigneeId == request.auth.uid;
    }

    // ─── Invite Tokens ─────────────────────────────────────────────────────────
    match /inviteTokens/{token} {
      allow read:   if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() &&
                       resource.data.status == 'pending';
      allow delete: if false;
    }

    // ─── Collection Group: connectionRequests ──────────────────────────────────
    match /{path=**}/connectionRequests/{requestId} {
      allow read, get: if isValidUser() && (
        resource.data.from == request.auth.uid ||
        resource.data.to   == request.auth.uid
      );
      allow list:   if isValidUser();
      allow create: if isValidUser() &&
                       request.resource.data.from == request.auth.uid;
      allow update: if isValidUser() && (
        resource.data.to   == request.auth.uid ||
        resource.data.from == request.auth.uid
      );
      allow delete: if isValidUser() && (
        resource.data.from == request.auth.uid ||
        resource.data.to   == request.auth.uid
      );
    }

    // ─── Collection Group: Applications ────────────────────────────────────────
    match /{path=**}/applications/{applicationId} {
      allow read: if isValidUser() && (
        resource.data.userId == request.auth.uid ||
        isProjectOwner(resource.data.projectId)  ||
        isProjectTeamLead(resource.data.projectId)
      );
      allow create: if isValidUser() &&
                       request.resource.data.userId == request.auth.uid;
      allow update: if isValidUser() && (
        resource.data.userId == request.auth.uid ||
        isProjectOwner(resource.data.projectId)  ||
        isProjectTeamLead(resource.data.projectId)
      );
      allow delete: if isValidUser() && (
        resource.data.userId == request.auth.uid ||
        isProjectOwner(resource.data.projectId)
      );
    }

    // ─── Users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, list, get: if isSignedIn();
      allow create:          if isValidUser() && isOwner(userId);
      allow update, write:   if isValidUser() && (isOwner(userId) || isAdmin());
      allow delete:          if isSignedIn()  && (isOwner(userId) || isAdmin());

      match /savedProjects/{projectId} {
        allow read, list, write: if isSignedIn() && isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow read, list:     if isSignedIn() && isOwner(userId);
        allow update, delete: if isSignedIn() && isOwner(userId);
        allow create: if isSignedIn()
          && request.resource.data.title is string
          && request.resource.data.body  is string
          && request.resource.data.read  == false;
      }

      match /activity/{activityId} {
        allow read, write, list: if isSignedIn() && isOwner(userId);
      }

      match /applications/{applicationId} {
        allow read, list, write: if isSignedIn() && isOwner(userId);
        allow create:            if isSignedIn() && isOwner(userId);
      }

      match /fcmTokens/{tokenId} {
        allow read, write: if isSignedIn() && isOwner(userId);
      }

      match /joinedProjects/{projectId} {
        allow read, list: if isSignedIn() && isOwner(userId);
        allow write:      if isSignedIn() && isOwner(userId);
        allow create:     if isSignedIn();
      }

      match /connectionRequests/{fromUserId} {
        allow create: if isSignedIn();
        allow read, list: if isSignedIn() && (
          request.auth.uid == userId ||
          request.auth.uid == fromUserId
        );
        allow update, delete, write: if isSignedIn() && (
          request.auth.uid == userId ||
          request.auth.uid == fromUserId
        );
      }

      match /connections/{otherUserId} {
        allow read, list, write: if isSignedIn() &&
          request.auth.uid == userId;
        allow create, update, delete: if isSignedIn() && (
          request.auth.uid == userId ||
          request.auth.uid == otherUserId
        );
      }

      match /friends/{friendUserId} {
        allow read, list, write: if isSignedIn() &&
          request.auth.uid == userId;
        allow create, update, delete: if isSignedIn() && (
          request.auth.uid == userId ||
          request.auth.uid == friendUserId
        );
      }
    }

    // ─── Projects ──────────────────────────────────────────────────────────────
    match /projects/{projectId} {

      // !! CRITICAL: public read so unauthenticated users can preview on invite
      // page AND so usePermissions/useProjectRole can read teamMembers map
      // without triggering permission errors
      allow read, list, get: if true;
      allow create:          if isValidUser();

      allow update: if isValidUser() && (
        isProjectOwner(projectId)    ||
        isProjectTeamLead(projectId) ||
        isAdmin()                    ||
        // Invited user accepting — ONLY adds themselves to members[]
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
          request.resource.data.members.hasAll(resource.data.members) &&
          request.resource.data.members.hasOnly(
            resource.data.members.concat([request.auth.uid])
          )
        )
      );

      allow delete: if isValidUser() && (
        isProjectOwner(projectId) || isAdmin()
      );

      // ── Tasks ─────────────────────────────────────────────────────────────────
      match /tasks/{taskId} {

        // !! CRITICAL FIX: must include BOTH `read` AND `list`
        // onSnapshot uses a list operation — missing `list` was causing the
        // "Error fetching tasks: Missing or insufficient permissions" error
        allow read, list, get: if isValidUser() && (
          isAdmin() || canAccessProject(projectId)
        );

        // CREATE: owner, admin, team lead only — plain members cannot create
        allow create: if isValidUser() && (
          isAdmin()                ||
          isProjectOwner(projectId) ||
          isProjectTeamLead(projectId)
        );

        // UPDATE:
        //   Owner / Admin / TeamLead → full update
        //   Assignee (plain member)  → status + review fields OR just status + updatedAt
        allow update: if isValidUser() && (
          isAdmin()                    ||
          isProjectOwner(projectId)    ||
          isProjectTeamLead(projectId) ||
          (isTaskAssignee() && (isOnlyStatusUpdate() || isAssigneeStatusUpdateWithReview()))
        );

        // DELETE: owner, admin, team lead only
        allow delete: if isValidUser() && (
          isAdmin()                ||
          isProjectOwner(projectId) ||
          isProjectTeamLead(projectId)
        );
      }

      // ── Applications ──────────────────────────────────────────────────────────
      match /applications/{applicationId} {
        allow read, list, get: if isValidUser() && (
          isProjectOwner(projectId)    ||
          isProjectTeamLead(projectId) ||
          resource.data.userId == request.auth.uid
        );
        allow create: if isValidUser() &&
          request.resource.data.userId == request.auth.uid;
        allow update: if isValidUser() && (
          resource.data.userId == request.auth.uid ||
          isProjectOwner(projectId)                ||
          isProjectTeamLead(projectId)
        );
        allow delete: if isValidUser() && (
          resource.data.userId == request.auth.uid ||
          isProjectOwner(projectId)
        );
      }

      // ── Comments ──────────────────────────────────────────────────────────────
      match /comments/{commentId} {
        allow read, list, get: if isValidUser();
        allow create: if isValidUser() &&
          request.resource.data.userId == request.auth.uid;
        allow update, delete: if isValidUser() && (
          resource.data.userId == request.auth.uid ||
          isProjectOwner(projectId)                ||
          isAdmin()
        );
      }

      // ── Messages ──────────────────────────────────────────────────────────────
      match /messages/{messageId} {
        allow read, list, get: if isValidUser() && canAccessProject(projectId);
        allow create: if isValidUser() &&
          canAccessProject(projectId) &&
          request.resource.data.userId == request.auth.uid;
        allow update: if isValidUser() &&
          resource.data.userId == request.auth.uid;
        allow delete: if isValidUser() && (
          resource.data.userId == request.auth.uid ||
          isProjectOwner(projectId)
        );
      }

      // ── Files ─────────────────────────────────────────────────────────────────
      match /files/{fileId} {
        allow read, list, get: if isValidUser() && canAccessProject(projectId);
        allow create: if isValidUser() &&
          canAccessProject(projectId) &&
          request.resource.data.uploadedBy == request.auth.uid;
        allow update: if isValidUser() &&
          resource.data.uploadedBy == request.auth.uid;
        allow delete: if isValidUser() && (
          resource.data.uploadedBy == request.auth.uid ||
          isProjectOwner(projectId)
        );
      }

      // ── Activities ────────────────────────────────────────────────────────────
      match /activities/{activityId} {
        allow read, list, get: if isValidUser() && canAccessProject(projectId);
        allow create: if isValidUser() &&
          canAccessProject(projectId) &&
          request.resource.data.userId == request.auth.uid;
        allow update: if isValidUser() &&
          resource.data.userId == request.auth.uid;
        allow delete: if isValidUser() && (
          resource.data.userId == request.auth.uid ||
          isProjectOwner(projectId)
        );
      }

      // ── Online Users ──────────────────────────────────────────────────────────
      match /onlineUsers/{userId} {
        allow read, list, get: if isValidUser() && canAccessProject(projectId);
        allow write: if isValidUser() &&
          request.auth.uid == userId &&
          canAccessProject(projectId);
      }

      // ── Time Logs ─────────────────────────────────────────────────────────────
      match /timeLogs/{logId} {
        allow read, list, get: if isValidUser() && canAccessProject(projectId);
        allow create:          if isValidUser() && canAccessProject(projectId);
        allow update, delete: if isValidUser() && (
          resource.data.userId == request.auth.uid ||
          isProjectOwner(projectId)
        );
      }

      // ── Resources ─────────────────────────────────────────────────────────────
      match /resources/{resourceId} {
        allow read, list, get: if isValidUser() && canAccessProject(projectId);
        allow write: if isValidUser() && (
          isProjectOwner(projectId) ||
          isProjectTeamLead(projectId)
        );
      }

      // ── Whiteboard ────────────────────────────────────────────────────────────
      match /whiteboard/{document=**} {
        allow read, list, get: if isValidUser() && canAccessProject(projectId);
        allow write:           if isValidUser() && canAccessProject(projectId);
      }

      // ── Members sub-collection ────────────────────────────────────────────────
      // READ + LIST: any project member
      //   - TaskDialog reads this to populate assignee dropdown
      //   - Must allow `list` so getDocs() works
      // WRITE: owner, lead, or the member themselves
      match /members/{memberId} {
        allow read, list, get: if isValidUser() && (
          canAccessProject(projectId) ||
          // Allow user to read their own member doc even before
          // they appear in teamMembers map (invite acceptance flow)
          request.auth.uid == memberId
        );
        allow write: if isValidUser() && (
          isProjectOwner(projectId)    ||
          isProjectTeamLead(projectId) ||
          request.auth.uid == memberId
        );
      }

      // ── Diagrams ──────────────────────────────────────────────────────────────
      match /diagrams/{diagramId} {
        allow read, list, get: if isValidUser() && canAccessProject(projectId);
        allow create: if isValidUser() &&
          canAccessProject(projectId) &&
          request.resource.data.createdBy == request.auth.uid;
        allow update: if isValidUser() && (
          resource.data.createdBy == request.auth.uid ||
          isProjectOwner(projectId)                   ||
          isProjectTeamLead(projectId)
        );
        allow delete: if isValidUser() && (
          resource.data.createdBy == request.auth.uid ||
          isProjectOwner(projectId)                   ||
          isProjectTeamLead(projectId)
        );
      }

      // ── Invitations ───────────────────────────────────────────────────────────
      match /invitations/{inviteId} {
        allow read, list, get: if isValidUser();
        allow create: if isValidUser() && (
          isProjectOwner(projectId) ||
          isProjectTeamLead(projectId)
        );
        allow update: if isValidUser() && (
          isProjectOwner(projectId)    ||
          isProjectTeamLead(projectId) ||
          resource.data.email == request.auth.token.email
        );
        allow delete: if isValidUser() && (
          isProjectOwner(projectId) ||
          isProjectTeamLead(projectId)
        );
      }

      // ── Join Requests ─────────────────────────────────────────────────────────
      match /joinRequests/{requestId} {
        allow read, get: if isValidUser() && (
          isProjectOwner(projectId)    ||
          isProjectTeamLead(projectId) ||
          resource.data.uid == request.auth.uid
        );
        allow list: if isValidUser() && (
          isProjectOwner(projectId) ||
          isProjectTeamLead(projectId)
        );
        allow create: if isValidUser() &&
          request.resource.data.uid == request.auth.uid;
        allow update: if isValidUser() && (
          isProjectOwner(projectId) ||
          isProjectTeamLead(projectId)
        );
        allow delete: if isValidUser() && (
          resource.data.uid == request.auth.uid ||
          isProjectOwner(projectId)
        );
      }

      // ── Documents ─────────────────────────────────────────────────────────────
      match /documents/{documentId} {
        allow read, list, get: if isValidUser() && canAccessProject(projectId);
        allow create: if isValidUser() &&
          canAccessProject(projectId) &&
          request.resource.data.createdBy == request.auth.uid;
        allow update: if isValidUser() && (
          resource.data.createdBy == request.auth.uid ||
          isProjectOwner(projectId)                   ||
          isProjectTeamLead(projectId)
        );
        allow delete: if isValidUser() && (
          resource.data.createdBy == request.auth.uid ||
          isProjectOwner(projectId)
        );
      }

      // ── Budget ────────────────────────────────────────────────────────────────
      match /budget/{configId} {
        allow read, list, get: if isValidUser() && canAccessProject(projectId);
        allow write: if isValidUser() && (
          isProjectOwner(projectId) ||
          isProjectTeamLead(projectId)
        );
      }

      // ── Expenses ──────────────────────────────────────────────────────────────
      match /expenses/{expenseId} {
        allow read, list, get: if isValidUser() && canAccessProject(projectId);
        allow create: if isValidUser() &&
          canAccessProject(projectId) &&
          request.resource.data.createdBy == request.auth.uid;
        allow update: if isValidUser() && (
          resource.data.createdBy == request.auth.uid ||
          isProjectOwner(projectId)                   ||
          isProjectTeamLead(projectId)
        );
        allow delete: if isValidUser() && (
          resource.data.createdBy == request.auth.uid ||
          isProjectOwner(projectId)
        );
      }

      // ── Sprints ───────────────────────────────────────────────────────────────
      match /sprints/{sprintId} {
        allow read, list, get: if isValidUser() && canAccessProject(projectId);
        allow create, update, delete: if isValidUser() && (
          isProjectOwner(projectId) ||
          isProjectTeamLead(projectId)
        );
      }

      // ── Meetings ──────────────────────────────────────────────────────────────
      match /meetings/{meetingId} {
        allow read, list, get: if isValidUser() && canAccessProject(projectId);
        allow create: if isValidUser() &&
          canAccessProject(projectId) &&
          request.resource.data.createdBy == request.auth.uid;
        allow update: if isValidUser() && (
          resource.data.createdBy == request.auth.uid ||
          isProjectOwner(projectId)                   ||
          isProjectTeamLead(projectId)
        );
        allow delete: if isValidUser() && (
          resource.data.createdBy == request.auth.uid ||
          isProjectOwner(projectId)
        );
      }

    } // end /projects/{projectId}

    // ─── Direct Messages ────────────────────────────────────────────────────────
    match /messages/{messageId} {
      allow read, list, get: if isValidUser() && (
        resource.data.senderId    == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );
      allow create: if isValidUser() &&
        request.resource.data.senderId == request.auth.uid;
      allow update: if isValidUser() &&
        resource.data.senderId == request.auth.uid;
      allow delete: if isValidUser() && (
        resource.data.senderId    == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );
    }

    // ─── Conversations ──────────────────────────────────────────────────────────
    match /conversations/{conversationId} {
      allow list: if isValidUser();

      allow read, get: if isValidUser() && (
        (resource.data.participants is list &&
          resource.data.participants.hasAny([request.auth.uid])) ||
        (resource.data.participants is map &&
          resource.data.participants[request.auth.uid] == true)
      );

      allow create: if isValidUser() && (
        (request.resource.data.participants is list &&
          request.resource.data.participants.hasAny([request.auth.uid])) ||
        (request.resource.data.participants is map &&
          request.resource.data.participants[request.auth.uid] == true)
      );

      allow update: if isValidUser() && (
        (resource.data.participants is list &&
          resource.data.participants.hasAny([request.auth.uid])) ||
        (resource.data.participants is map &&
          resource.data.participants[request.auth.uid] == true)
      );

      allow delete: if isValidUser() &&
        resource.data.createdBy == request.auth.uid && (
          (resource.data.participants is list &&
            resource.data.participants.hasAny([request.auth.uid])) ||
          (resource.data.participants is map &&
            resource.data.participants[request.auth.uid] == true)
        );

      // ── Conversation Messages ─────────────────────────────────────────────────
      match /messages/{messageId} {
        function isConvoParticipant() {
          let convo = get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data;
          return (
            (convo.participants is list &&
              convo.participants.hasAny([request.auth.uid])) ||
            (convo.participants is map &&
              convo.participants[request.auth.uid] == true)
          );
        }

        allow read, list, get: if isValidUser() && isConvoParticipant();
        allow create: if isValidUser() &&
          isConvoParticipant() &&
          request.resource.data.senderId == request.auth.uid;
        allow update: if isValidUser() &&
          resource.data.senderId == request.auth.uid;
        allow delete: if isValidUser() &&
          resource.data.senderId == request.auth.uid;
      }
    }

    // ─── Global Notifications ───────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read, list, get: if isValidUser() &&
        resource.data.userId == request.auth.uid;
      allow create: if isValidUser();
      allow update: if isValidUser() &&
        resource.data.userId == request.auth.uid;
      allow delete: if isValidUser() &&
        resource.data.userId == request.auth.uid;
    }

    // ─── Reports ────────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if isValidUser() &&
        request.resource.data.reportedBy == request.auth.uid;
      allow read, list, get: if isValidUser() && (
        resource.data.reportedBy == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isValidUser() && isAdmin();
    }

    // ─── FCM Queue ──────────────────────────────────────────────────────────────
    match /fcmQueue/{docId} {
      allow create: if isValidUser()
        && request.resource.data.recipientUserId is string
        && request.resource.data.tokens is list
        && request.resource.data.tokens.size() > 0
        && request.resource.data.tokens.size() <= 10;
      allow read, update, delete: if false;
    }

    // ─── System ─────────────────────────────────────────────────────────────────
    match /system/{document=**} {
      allow read, list, get: if isValidUser();
      allow write:           if isValidUser() && isAdmin();
    }

    // ─── Public Data ────────────────────────────────────────────────────────────
    match /public/{document=**} {
      allow read, list, get: if true;
      allow write:           if isValidUser() && isAdmin();
    }

    // ─── Announcements ──────────────────────────────────────────────────────────
    match /announcements/{announcementId} {
      allow read, list, get:        if isSignedIn();
      allow create, update, delete: if isValidUser() && isAdmin();
    }

    // ─── Admin Logs ─────────────────────────────────────────────────────────────
    match /adminLogs/{logId} {
      allow read, list, get: if isValidUser() && isAdmin();
      allow create:          if isValidUser() && isAdmin();
      allow update, delete:  if false;
    }

    // ─── Moderation Queue ───────────────────────────────────────────────────────
    match /moderationQueue/{itemId} {
      allow read, list, get: if isValidUser() && isAdmin();
      allow create: if isValidUser() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isValidUser() && isAdmin();
    }

    // ─── Events ─────────────────────────────────────────────────────────────────
    match /events/{eventId} {
      allow read, list, get:        if isSignedIn();
      allow create, update, delete: if isValidUser() && isAdmin();
    }

    // ─── Event Teams ────────────────────────────────────────────────────────────
    match /eventTeams/{teamId} {
      allow read, list, get: if isSignedIn();
      allow create: if isValidUser() &&
        request.resource.data.captainId == request.auth.uid;
      allow update: if isValidUser() &&
        resource.data.captainId == request.auth.uid;
      allow delete: if isValidUser() && (
        resource.data.captainId == request.auth.uid ||
        isAdmin()
      );
    }

    // ─── Event Join Requests ─────────────────────────────────────────────────────
    match /eventJoinRequests/{requestId} {
      allow read, get: if isValidUser() && (
        resource.data.userId == request.auth.uid ||
        (
          exists(/databases/$(database)/documents/eventTeams/$(resource.data.teamId)) &&
          get(/databases/$(database)/documents/eventTeams/$(resource.data.teamId))
            .data.captainId == request.auth.uid
        )
      );
      allow list:   if isValidUser();
      allow create: if isValidUser() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isValidUser() && (
        exists(/databases/$(database)/documents/eventTeams/$(resource.data.teamId)) &&
        get(/databases/$(database)/documents/eventTeams/$(resource.data.teamId))
          .data.captainId == request.auth.uid
      );
      allow delete: if isValidUser() && (
        resource.data.userId == request.auth.uid ||
        (
          exists(/databases/$(database)/documents/eventTeams/$(resource.data.teamId)) &&
          get(/databases/$(database)/documents/eventTeams/$(resource.data.teamId))
            .data.captainId == request.auth.uid
        )
      );
    }

  } // end match /databases/{database}/documents
}